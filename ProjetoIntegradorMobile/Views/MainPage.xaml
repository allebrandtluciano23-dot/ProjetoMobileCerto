<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.MainPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             xmlns:models="clr-namespace:ProjetoIntegradorMobile.Models"
             x:DataType="vm:MainViewModel"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CABEÇALHO parte pessoal -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,15,20,5"
                             Spacing="15">

            <!-- Saudação ola-->
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Foto do usuário com border???-->
                <Border WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        BackgroundColor="#EEEEEE"
                        StrokeShape="RoundRectangle 24">

                    <Label Text="👨‍🍳"
                           FontSize="25"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Margin="12,0,0,0"
                                     VerticalOptions="Center">

                    <Label Text="{Binding Saudacao}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Label Text="Vamos cozinhar algo delicioso."
                           FontSize="13"
                           TextColor="Gray"/>
                </VerticalStackLayout>

                <!-- Botão menu para busca-->
                <Border Grid.Column="2"
                        WidthRequest="45"
                        HeightRequest="45"
                        Stroke="#EEEEEE"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 15">

                    <Label Text="☰"
                           FontSize="20"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

            </Grid>


            <!-- BARRA DE PESQUISA para busca tbmm -->
            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,0">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Label Text="⌕"
                           FontSize="30"
                           TextColor="Black"
                           VerticalOptions="Center"/>

                    <Entry Grid.Column="1"
                           x:Name="searchEntry"
                           Text="{Binding Filtro}"
                           Placeholder="Buscar receitas"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="2"
                           Text="☷"
                           FontSize="22"
                           TextColor="Black"
                           VerticalOptions="Center"/>

                </Grid>

            </Border>


            <!-- CATEGORIAS divididas, decidir layout -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout x:Name="hsCategorias" Spacing="10">

                    <Border BackgroundColor="Black" StrokeThickness="0" Padding="20,10" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Categoria_Tapped" CommandParameter="Todos"/>
                        </Border.GestureRecognizers>

                        <Label Text="Todos"
                               TextColor="White" FontAttributes="Bold"/>
                    </Border>

                    <Border BackgroundColor="#F3F3F3" StrokeThickness="0" Padding="20,10" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Categoria_Tapped" CommandParameter="Rápidos"/>
                        </Border.GestureRecognizers>

                        <Label Text="Rápidos"
                               TextColor="Black"/>
                    </Border>

                    <Border BackgroundColor="#F3F3F3" StrokeThickness="0" Padding="20,10" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Categoria_Tapped" CommandParameter="Almoço"/>
                        </Border.GestureRecognizers>

                        <Label Text="Almoço"
                               TextColor="Black"/>
                    </Border>

                    <Border BackgroundColor="#F3F3F3" StrokeThickness="0" Padding="20,10" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Categoria_Tapped" CommandParameter="Jantar"/>
                        </Border.GestureRecognizers>

                        <Label Text="Jantar"
                               TextColor="Black"/>
                    </Border>

                    <Border BackgroundColor="#F3F3F3" StrokeThickness="0" Padding="20,10" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Categoria_Tapped" CommandParameter="Sobremesas"/>
                        </Border.GestureRecognizers>

                        <Label Text="Sobremesas"
                               TextColor="Black"/>
                    </Border>

                </HorizontalStackLayout>

            </ScrollView>

        </VerticalStackLayout>


        <!-- CONTEÚDO: receitas do banco, filtradas pela busca e pela categoria -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="20,10,20,0">

            <Label Grid.Row="0"
                   Text="Receitas"
                   FontSize="21"
                   FontAttributes="Bold"
                   TextColor="Black"
                   Margin="0,0,0,10"/>

            <!-- Mensagem de erro (só aparece se o banco falhar) -->
            <Label Grid.Row="1"
                   Text="{Binding MensagemErro}"
                   IsVisible="{Binding TemErro}"
                   FontSize="13"
                   TextColor="#D32F2F"
                   Margin="0,0,0,10"/>

            <CollectionView Grid.Row="2"
                            x:Name="cvReceitas"
                            ItemsSource="{Binding Receitas}"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <!-- Aparece quando não há receita (banco vazio ou filtro sem resultado) -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,40" Spacing="5">
                        <Label Text="🍽"
                               FontSize="40"
                               HorizontalOptions="Center"/>
                        <Label Text="Nenhuma receita encontrada."
                               FontSize="15"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Card de cada receita -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReceitaResumo">

                        <Border Stroke="#EEEEEE"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 18"
                                Padding="15">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                                <VerticalStackLayout Grid.Column="0" Spacing="3">

                                    <Label Text="{Binding Titulo}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="Black"/>

                                    <Label Text="{Binding NomeCategoria}"
                                           FontSize="13"
                                           TextColor="Gray"/>

                                    <Label Text="{Binding Detalhes}"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                </VerticalStackLayout>

                                <!-- Coração só nas receitas marcadas como favoritas -->
                                <Label Grid.Column="1"
                                       Text="♥"
                                       FontSize="22"
                                       TextColor="#D32F2F"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Favorita}"/>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>


        <!-- MENU INFERIOR pra navegação-->
        <Border Grid.Row="2" BackgroundColor="White" Stroke="#EEEEEE" StrokeThickness="1" Padding="5,8">

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- INÍCIO -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Inicio_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="⌂"
                           TextColor="Black"
                           FontSize="25"
                           HorizontalOptions="Center"/>

                    <Label Text="Início"
                           FontSize="11"
                           HorizontalOptions="Center"
                           TextColor="Black"/>

                </VerticalStackLayout>


                <!-- BUSCAR -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Buscar_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Label Text="⌕"
                           FontSize="25"
                           HorizontalOptions="Center"
                           TextColor="Black"/>

                    <Label Text="Buscar"
                           FontSize="11"
                           TextColor="Black"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>


                <!-- FAVORITOS -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Favoritos_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    
                    <Label Text="♡"
                           FontSize="25"
                           HorizontalOptions="Center"
                           TextColor="Black"/>

                    <Label Text="Favoritos"
                           FontSize="11"
                           TextColor="Black"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>


                <!-- PERFIL -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Perfil_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    
                    <Label Text="♙"
                           FontSize="25"
                           HorizontalOptions="Center"
                           TextColor="Black"/>

                    <Label Text="Perfil"
                           FontSize="11"
                           TextColor="Black"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>