<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.EntradaPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="30,60,30,30" Spacing="20">

            <!-- LOGO -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                <Label Text="CheefBook"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"/>

                <Label Text="Receitas que se adaptam a você"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>


            <!-- CAMPO USUÁRIO / E-MAIL -->
            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="55"
                    Margin="0,25,0,0"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,0">

                <Grid ColumnDefinitions="Auto,*">
                    
                    <Entry Grid.Column="1"
                           x:Name="usuarioEntry"
                           Placeholder="Usuário ou e-mail"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           Keyboard="Email"
                           VerticalOptions="Center"/>

                </Grid>
            </Border>


            <!-- CAMPO SENHA -->
            <Border Stroke="#EEEEEE"
            StrokeThickness="1"
            BackgroundColor="White"
            HeightRequest="55"
            StrokeShape="RoundRectangle 18"
            Padding="15,0">

                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <Entry Grid.Column="1"
                        x:Name="senhaEntry"
                        Placeholder="Senha"
                        PlaceholderColor="Gray"
                        TextColor="Black"
                        FontSize="14"
                        IsPassword="True"
                        VerticalOptions="Center"/>

                    <!-- Mostrar / ocultar senha -->
                    <Image Grid.Column="2"
                        x:Name="imgOlho"
                        Source="eye_off.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        VerticalOptions="Center">
                        
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MostrarSenha_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
            </Border>


            <!-- LEMBRAR DE MIM / ESQUECEU A SENHA -->
            <Grid ColumnDefinitions="*,Auto">

                <Label Grid.Column="1"
                       Text="Esqueceu sua senha?"
                       FontSize="13"
                       TextColor="Gray"
                       TextDecorations="Underline"
                       VerticalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="EsqueceuSenha_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </Grid>


            <!-- MENSAGEM DE ERRO -->
            <Label x:Name="lblErro"
                   Text=""
                   FontSize="13"
                   TextColor="#D32F2F"
                   HorizontalOptions="Center"
                   IsVisible="False"/>


            <!-- BOTÃO ENTRAR -->
            <Border BackgroundColor="Black"
                    StrokeThickness="0"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 18">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Entrar_Tapped"/>
                </Border.GestureRecognizers>

                <Label Text="Entrar"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>


            <!-- CADASTRO -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">

                <Label Text="Não tem uma conta?"
                       FontSize="13"
                       TextColor="Gray"/>

                <Label Text="Cadastre-se"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="Black"
                       TextDecorations="Underline">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Cadastrar_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>