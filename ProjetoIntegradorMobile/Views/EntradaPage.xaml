<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.EntradaPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             xmlns:views="clr-namespace:ProjetoIntegradorMobile.Views"
             x:DataType="vm:EntradaViewModel"
             BackgroundColor="{StaticResource Fundo}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <ScrollView>

            <VerticalStackLayout Padding="24,56,24,36" Spacing="24">

                <!-- Marca -->
                <VerticalStackLayout Spacing="10">

                    <Image Source="chef.png"
                           WidthRequest="96"
                           HeightRequest="96"
                           Aspect="AspectFit"
                           HorizontalOptions="Start"/>

                    <Label Text="CheefBook"
                           FontFamily="Bricolage"
                           FontSize="38"/>

                    <Label Text="Receitas que se adaptam a você"
                           Style="{StaticResource TextoSecundario}"
                           FontSize="15"/>
                </VerticalStackLayout>

                <!-- Campos -->
                <VerticalStackLayout Spacing="14">

                    <!-- E-mail -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Usuário ou e-mail" Style="{StaticResource Rotulo}"/>

                        <Border Stroke="{StaticResource Borda}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource Cartao}"
                                HeightRequest="52"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,0">

                            <Entry x:Name="txEmail"
                                   Text="{Binding Email}"
                                   Placeholder="seu@email.com"
                                   FontSize="15"
                                   Keyboard="Email"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Senha -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Senha" Style="{StaticResource Rotulo}"/>

                        <Border Stroke="{StaticResource Borda}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource Cartao}"
                                HeightRequest="52"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,0">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                <Entry x:Name="txSenha"
                                       Text="{Binding Senha}"
                                       Placeholder="Sua senha"
                                       FontSize="15"
                                       IsPassword="True"
                                       VerticalOptions="Center"/>

                                <!-- Mostrar/ocultar senha -->
                                <Image Grid.Column="1"
                                       x:Name="imOlho"
                                       Source="eye_off.png"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       Opacity="0.55"
                                       VerticalOptions="Center">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="MostrarSenha_Tapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Esqueceu a senha -->
                    <Label Text="Esqueceu sua senha?"
                           FontFamily="InterSemiBold"
                           FontSize="13"
                           TextColor="{StaticResource Destaque}"
                           HorizontalOptions="End">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EsqueceuSenha_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Erro -->
                <Label x:Name="lbErro"
                       Text="{Binding MensagemErro}"
                       Style="{StaticResource TextoErro}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding TemErro}"/>

                <!-- Entrar -->
                <Border BackgroundColor="{StaticResource Destaque}"
                        StrokeThickness="0"
                        HeightRequest="54"
                        StrokeShape="RoundRectangle 16">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Entrar_Tapped"/>
                    </Border.GestureRecognizers>

                    <Label Text="Entrar"
                           FontFamily="InterSemiBold"
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Cadastro -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,12,0,0">

                    <Label Text="Não tem uma conta?"
                           Style="{StaticResource TextoSecundario}"
                           FontSize="14"/>

                    <Label Text="Cadastre-se"
                           FontFamily="InterSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource Destaque}">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Cadastrar_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Cartão de aviso -->
        <views:CartaoAviso x:Name="grAviso"/>
    </Grid>

</ContentPage>
