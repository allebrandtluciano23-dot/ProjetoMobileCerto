<?xml version="1.0" encoding="utf-8" ?>

<!--
    CARTÃO DE AVISO (substitui o DisplayAlertAsync, que no Windows é uma janela escura).
    Fica escondido por cima da tela; o código da página chama:
        bool bConfirmou = await grAviso.MostrarAsync("Título", "Mensagem", "Excluir", "Cancelar", bPerigo: true);
    Mesmo visual do aviso "Entre na sua conta" da tela inicial.
-->
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      x:Class="ProjetoIntegradorMobile.Views.CartaoAviso"
      BackgroundColor="{StaticResource FundoEscurecido}"
      IsVisible="False">

    <!-- Tocar fora do cartão = cancelar -->
    <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="Fundo_Tapped"/>
    </Grid.GestureRecognizers>

    <Border BackgroundColor="{StaticResource Fundo}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24"
            Padding="24"
            Margin="30,0"
            MaximumWidthRequest="360"
            VerticalOptions="Center">

        <!-- Toque no cartão não fecha o aviso -->
        <Border.GestureRecognizers>
            <TapGestureRecognizer/>
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="12">

            <!-- Ícone: chapéu (aviso comum) ou lixeira (exclusão) -->
            <Border x:Name="bdIcone"
                    WidthRequest="64"
                    HeightRequest="64"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource FundoAvatar}"
                    StrokeShape="RoundRectangle 32"
                    HorizontalOptions="Center">
                <Path x:Name="paIcone"
                      Data="{StaticResource IconeChapeu}"
                      Style="{StaticResource Icone}"
                      Stroke="{StaticResource Destaque}"
                      WidthRequest="30"
                      HeightRequest="30"/>
            </Border>

            <Label x:Name="lbTitulo"
                   Style="{StaticResource TituloSecao}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <Label x:Name="lbMensagem"
                   Style="{StaticResource TextoSecundario}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <Button x:Name="btConfirmar"
                    Style="{StaticResource BotaoPrincipal}"
                    Margin="0,8,0,0"
                    Clicked="btConfirmar_Clicked"/>

            <Button x:Name="btCancelar"
                    Style="{StaticResource BotaoSuave}"
                    Clicked="btCancelar_Clicked"/>
        </VerticalStackLayout>
    </Border>
</Grid>
