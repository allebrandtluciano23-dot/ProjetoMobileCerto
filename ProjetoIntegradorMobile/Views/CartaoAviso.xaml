<?xml version="1.0" encoding="utf-8" ?>

<!-- Cartão de aviso/confirmação (uso: await grAviso.MostrarAsync(...)) -->
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      x:Class="ProjetoIntegradorMobile.Views.CartaoAviso"
      BackgroundColor="{StaticResource FundoEscurecido}"
      IsVisible="False">

    <!-- Tocar fora cancela -->
    <Grid.GestureRecognizers>
        <TapGestureRecognizer Tapped="Fundo_Tapped"/>
    </Grid.GestureRecognizers>

    <Border BackgroundColor="{StaticResource Fundo}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24"
            Padding="24"
            Margin="20,0"
            WidthRequest="320"
            HorizontalOptions="Center"
            VerticalOptions="Center">

        <!-- Tocar no cartão não fecha -->
        <Border.GestureRecognizers>
            <TapGestureRecognizer/>
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="12">

            <!-- Ícone: chef ou lixeira -->
            <Border x:Name="bdIcone"
                    WidthRequest="64"
                    HeightRequest="64"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource FundoAvatar}"
                    StrokeShape="RoundRectangle 32"
                    HorizontalOptions="Center">
                <Grid>
                    <Image x:Name="imIcone"
                           Source="chef.png"
                           WidthRequest="54"
                           HeightRequest="54"
                           Aspect="AspectFit"/>

                    <Path x:Name="paIcone"
                          Data="{StaticResource IconeLixeira}"
                          Style="{StaticResource Icone}"
                          Stroke="{StaticResource Perigo}"
                          WidthRequest="30"
                          HeightRequest="30"
                          IsVisible="False"/>
                </Grid>
            </Border>

            <Label x:Name="lbTitulo"
                   Style="{StaticResource TituloSecao}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <Label x:Name="lbMensagem"
                   Style="{StaticResource TextoSecundario}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <Button x:Name="btConfirmar"
                    Style="{StaticResource BotaoPrincipal}"
                    Margin="0,8,0,0"
                    Clicked="btConfirmar_Clicked"/>

            <Button x:Name="btCancelar"
                    Style="{StaticResource BotaoSuave}"
                    Clicked="btCancelar_Clicked"/>
        </VerticalStackLayout>
    </Border>
</Grid>
