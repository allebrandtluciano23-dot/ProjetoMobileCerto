<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.PerfilPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             x:DataType="vm:PerfilViewModel"
             BackgroundColor="{StaticResource Fundo}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView>
            <VerticalStackLayout Padding="20,8,20,24" Spacing="22">

                <Label Text="Meu perfil" Style="{StaticResource TituloTela}"/>

                <!-- FOTO, NOME E E-MAIL -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">

                    <!-- Toque na foto: escolher uma foto da galeria -->
                    <Grid WidthRequest="104" HeightRequest="104" HorizontalOptions="Center">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Foto_Tapped"/>
                        </Grid.GestureRecognizers>

                        <Border StrokeThickness="0"
                                BackgroundColor="{StaticResource FundoAvatar}"
                                StrokeShape="RoundRectangle 52">
                            <Grid>
                                <Path Data="{StaticResource IconeChapeu}"
                                      Style="{StaticResource Icone}"
                                      Stroke="{StaticResource Destaque}"
                                      WidthRequest="44"
                                      HeightRequest="44"
                                      IsVisible="{Binding SemFoto}"/>

                                <Image x:Name="imFoto"
                                       Source="{Binding CaminhoFoto}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding TemFoto}"/>
                            </Grid>
                        </Border>

                        <!-- Selo de câmera -->
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                Stroke="{StaticResource Fundo}"
                                StrokeThickness="3"
                                BackgroundColor="{StaticResource Destaque}"
                                StrokeShape="RoundRectangle 17"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Path Data="{StaticResource IconeCamera}"
                                  Style="{StaticResource Icone}"
                                  Stroke="White"
                                  WidthRequest="15"
                                  HeightRequest="15"/>
                        </Border>
                    </Grid>

                    <Label x:Name="lbNome"
                           Text="{Binding Nome}"
                           Style="{StaticResource TituloSecao}"
                           FontSize="22"
                           HorizontalOptions="Center"
                           Margin="0,6,0,0"/>

                    <Label x:Name="lbEmail"
                           Text="{Binding Email}"
                           Style="{StaticResource TextoSecundario}"
                           FontSize="14"
                           HorizontalOptions="Center"/>

                    <Label Text="Toque na foto para alterar"
                           FontSize="12"
                           TextColor="{StaticResource TextoFraco}"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding MensagemErro}"
                           IsVisible="{Binding TemErro}"
                           Style="{StaticResource TextoErro}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>


                <!-- MINHAS RECEITAS -->
                <VerticalStackLayout Spacing="8">

                    <Label Text="Minhas receitas"
                           Style="{StaticResource Sobrelinha}"
                           TextColor="{StaticResource TextoSuave}"
                           Margin="4,0,0,0"/>

                    <Border BackgroundColor="{StaticResource Cartao}"
                            Stroke="{StaticResource BordaCartao}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,0">

                        <VerticalStackLayout>

                            <!-- Criadas por mim -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,14" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="MinhasReceitas_Tapped"/>
                                </Grid.GestureRecognizers>

                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                        BackgroundColor="{StaticResource FundoIcone}" StrokeShape="RoundRectangle 12">
                                    <Path Data="{StaticResource IconeEditar}" Style="{StaticResource Icone}"
                                          Stroke="{StaticResource Destaque}" WidthRequest="18" HeightRequest="18"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Criadas por mim" FontSize="15"/>
                                    <Label Text="Receitas que você publicou" Style="{StaticResource TextoSecundario}" FontSize="12"/>
                                </VerticalStackLayout>

                                <Path Grid.Column="2" Data="{StaticResource IconeSeta}" Style="{StaticResource Icone}"
                                      Stroke="{StaticResource TextoFraco}" WidthRequest="16" HeightRequest="16"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Divisor}"/>

                            <!-- Cópias capturadas -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,14" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="MinhasAdaptacoes_Tapped"/>
                                </Grid.GestureRecognizers>

                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                        BackgroundColor="{StaticResource FundoIcone}" StrokeShape="RoundRectangle 12">
                                    <Path Data="{StaticResource IconeCopiar}" Style="{StaticResource Icone}"
                                          Stroke="{StaticResource Destaque}" WidthRequest="18" HeightRequest="18"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Cópias capturadas" FontSize="15"/>
                                    <Label Text="Suas versões de receitas de outros" Style="{StaticResource TextoSecundario}" FontSize="12"/>
                                </VerticalStackLayout>

                                <Path Grid.Column="2" Data="{StaticResource IconeSeta}" Style="{StaticResource Icone}"
                                      Stroke="{StaticResource TextoFraco}" WidthRequest="16" HeightRequest="16"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Divisor}"/>

                            <!-- Favoritos -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,14" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Favoritos_Tapped"/>
                                </Grid.GestureRecognizers>

                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                        BackgroundColor="{StaticResource FundoIcone}" StrokeShape="RoundRectangle 12">
                                    <Path Data="{StaticResource IconeCoracao}" Style="{StaticResource Icone}"
                                          Stroke="{StaticResource Destaque}" WidthRequest="18" HeightRequest="18"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Favoritos" FontSize="15"/>
                                    <Label Text="Receitas que você marcou" Style="{StaticResource TextoSecundario}" FontSize="12"/>
                                </VerticalStackLayout>

                                <Path Grid.Column="2" Data="{StaticResource IconeSeta}" Style="{StaticResource Icone}"
                                      Stroke="{StaticResource TextoFraco}" WidthRequest="16" HeightRequest="16"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>


                <!-- MINHA CONTA -->
                <VerticalStackLayout Spacing="8">

                    <Label Text="Minha conta"
                           Style="{StaticResource Sobrelinha}"
                           TextColor="{StaticResource TextoSuave}"
                           Margin="4,0,0,0"/>

                    <Border BackgroundColor="{StaticResource PerigoClaro}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="52">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Sair_Tapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconeSair}"
                                  Style="{StaticResource Icone}"
                                  Stroke="{StaticResource Perigo}"
                                  WidthRequest="18"
                                  HeightRequest="18"/>
                            <Label Text="Sair da conta"
                                   FontFamily="InterSemiBold"
                                   FontSize="15"
                                   TextColor="{StaticResource Perigo}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ===================== MENU INFERIOR ===================== -->
        <Grid Grid.Row="1"
              RowDefinitions="1,Auto"
              BackgroundColor="{StaticResource Cartao}">

            <BoxView Color="{StaticResource BordaCartao}"/>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Padding="12,10,12,14">

                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Inicio_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Path Data="{StaticResource IconeInicio}"
                          Style="{StaticResource Icone}"
                          Stroke="{StaticResource TextoSuave}"/>
                    <Label Text="Início"
                           FontSize="11"
                           TextColor="{StaticResource TextoSuave}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Favoritos_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Path Data="{StaticResource IconeCoracao}"
                          Style="{StaticResource Icone}"
                          Stroke="{StaticResource TextoSuave}"/>
                    <Label Text="Favoritos"
                           FontSize="11"
                           TextColor="{StaticResource TextoSuave}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- PERFIL (tela atual: na cor principal) -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Perfil_Tapped"/>
                    </VerticalStackLayout.GestureRecognizers>

                    <Path Data="{StaticResource IconePerfil}"
                          Style="{StaticResource Icone}"
                          Stroke="{StaticResource Destaque}"/>
                    <Label Text="Perfil"
                           FontFamily="InterSemiBold"
                           FontSize="11"
                           TextColor="{StaticResource Destaque}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

    </Grid>

</ContentPage>
