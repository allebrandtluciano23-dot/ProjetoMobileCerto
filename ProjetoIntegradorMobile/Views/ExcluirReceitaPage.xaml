<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.ExcluirReceitaPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             x:DataType="vm:ExcluirReceitaViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="30,50,30,0">

            <Label Text="←"
                   FontSize="28"
                   TextColor="Black"
                   VerticalOptions="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="Receitas"
                   FontSize="16"
                   TextColor="Black"
                   Margin="15,0,0,0"
                   VerticalOptions="Center"/>

        </Grid>


        <!-- CONTEÚDO -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="30,0,30,30"
                             Spacing="20"
                             VerticalOptions="Center">

            <!-- Ícone -->
            <Border WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    BackgroundColor="#F3F3F3"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 50">

                <Label Text="🗑"
                       FontSize="45"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Textos -->
            <VerticalStackLayout Spacing="10">

                <Label Text="Excluir receita?"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"/>

                <Label x:Name="lbMensagem"
                       Text="{Binding Mensagem}"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>

            <!-- Mensagem de erro -->
            <Label x:Name="lbErro"
                   Text="{Binding MensagemErro}"
                   FontSize="13"
                   TextColor="#D32F2F"
                   HorizontalOptions="Center"
                   IsVisible="{Binding TemErro}"/>

            <!-- Botão excluir -->
            <Button x:Name="btExcluir"
                    Text="Excluir"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#D32F2F"
                    HeightRequest="55"
                    CornerRadius="18"
                    Margin="0,15,0,0"
                    Clicked="btExcluir_Clicked"/>

            <!-- Botão cancelar -->
            <Button x:Name="btCancelar"
                    Text="Cancelar"
                    FontSize="16"
                    TextColor="Black"
                    BackgroundColor="#F3F3F3"
                    BorderColor="#EEEEEE"
                    BorderWidth="1"
                    HeightRequest="55"
                    CornerRadius="18"
                    Clicked="btCancelar_Clicked"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>