<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.ExcluirReceitaPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             x:DataType="vm:ExcluirReceitaViewModel"
             BackgroundColor="{StaticResource Fundo}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO: voltar -->
        <Border Grid.Row="0"
                WidthRequest="44"
                HeightRequest="44"
                Stroke="{StaticResource Borda}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource Cartao}"
                StrokeShape="RoundRectangle 14"
                HorizontalOptions="Start"
                Margin="20,45,20,0">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Voltar_Tapped"/>
            </Border.GestureRecognizers>

            <Path Data="{StaticResource IconeVoltar}"
                  Style="{StaticResource Icone}"
                  WidthRequest="18"
                  HeightRequest="18"/>
        </Border>


        <!-- CONTEÚDO -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="24,0,24,30"
                             Spacing="18"
                             VerticalOptions="Center">

            <!-- Ícone -->
            <Border WidthRequest="96"
                    HeightRequest="96"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource PerigoClaro}"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 48">

                <Path Data="{StaticResource IconeLixeira}"
                      Style="{StaticResource Icone}"
                      Stroke="{StaticResource Perigo}"
                      WidthRequest="40"
                      HeightRequest="40"/>
            </Border>

            <!-- Textos -->
            <VerticalStackLayout Spacing="10">

                <Label Text="Excluir receita?"
                       Style="{StaticResource TituloTela}"
                       HorizontalOptions="Center"/>

                <Label x:Name="lbMensagem"
                       Text="{Binding Mensagem}"
                       Style="{StaticResource TextoSecundario}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Mensagem de erro -->
            <Label x:Name="lbErro"
                   Text="{Binding MensagemErro}"
                   Style="{StaticResource TextoErro}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding TemErro}"/>

            <!-- Botão excluir (vermelho cheio: é a ação que não tem volta) -->
            <Button x:Name="btExcluir"
                    Text="Excluir"
                    Style="{StaticResource BotaoBase}"
                    BackgroundColor="{StaticResource Perigo}"
                    TextColor="White"
                    Margin="0,12,0,0"
                    Clicked="btExcluir_Clicked"/>

            <!-- Botão cancelar -->
            <Button x:Name="btCancelar"
                    Text="Cancelar"
                    Style="{StaticResource BotaoSuave}"
                    Clicked="btCancelar_Clicked"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
