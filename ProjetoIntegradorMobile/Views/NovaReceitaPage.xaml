<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.NovaReceitaPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             xmlns:models="clr-namespace:ProjetoIntegradorMobile.Models"
             x:DataType="vm:NovaReceitaViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="30,50,30,30" Spacing="18">

            <!-- CABEÇALHO -->
            <Grid ColumnDefinitions="Auto,*">

                <Label Text="←"
                       FontSize="28"
                       TextColor="Black"
                       VerticalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Voltar_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="{Binding TituloTela}"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="Black"
                       Margin="15,0,0,0"
                       VerticalOptions="Center"/>

            </Grid>


            <!-- ADICIONAR FOTO -->
            <Border Stroke="Gray"
                    StrokeThickness="1"
                    StrokeDashArray="4,4"
                    BackgroundColor="White"
                    HeightRequest="160"
                    Margin="0,10,0,0"
                    StrokeShape="RoundRectangle 18">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AdicionarFoto_Tapped"/>
                </Border.GestureRecognizers>

                <Grid>

                    <!-- Foto escolhida -->
                    <Image x:Name="imFoto"
                           Source="{Binding CaminhoFoto}"
                           Aspect="AspectFill"
                           IsVisible="{Binding TemFoto}"/>

                    <!-- Texto padrão (enquanto não tem foto) -->
                    <VerticalStackLayout x:Name="slFotoVazia"
                                         IsVisible="{Binding SemFoto}"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">

                        <Label Text="📷"
                               FontSize="34"
                               HorizontalOptions="Center"/>

                        <Label Text="Adicionar foto (opcional)"
                               FontSize="14"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </Grid>
            </Border>


            <!-- NOME DA RECEITA -->
            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,0">

                <Entry x:Name="txTitulo"
                       Text="{Binding Titulo}"
                       Placeholder="Nome da receita"
                       PlaceholderColor="Gray"
                       TextColor="Black"
                       FontSize="14"
                       MaxLength="80"
                       VerticalOptions="Center"/>
            </Border>


            <!-- CATEGORIA E TEMPO DE PREPARO -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                <!-- Categoria -->
                <VerticalStackLayout Grid.Column="0" Spacing="5">

                    <Label Text="Categoria"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Border Stroke="#EEEEEE"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            HeightRequest="55"
                            StrokeShape="RoundRectangle 18"
                            Padding="15,0">

                        <Picker x:Name="pkCategoria"
                                ItemsSource="{Binding Categorias}"
                                SelectedItem="{Binding CategoriaSelecionada}"
                                Title="Selecione"
                                TitleColor="Gray"
                                TextColor="Black"
                                FontSize="14"
                                VerticalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>


                <!-- Tempo de preparo -->
                <VerticalStackLayout Grid.Column="1" Spacing="5">

                    <Label Text="Tempo (h:min)"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Border Stroke="#EEEEEE"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            HeightRequest="55"
                            StrokeShape="RoundRectangle 18"
                            Padding="15,0">

                        <TimePicker x:Name="tpTempo"
                                    Time="{Binding TempoPreparo}"
                                    Format="HH:mm"
                                    TextColor="Black"
                                    FontSize="14"
                                    VerticalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>

            </Grid>


            <!-- PORÇÕES E VEGETARIANA -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                <VerticalStackLayout Grid.Column="0" Spacing="5">

                    <Label Text="Porções"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Border Stroke="#EEEEEE"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            HeightRequest="55"
                            StrokeShape="RoundRectangle 18"
                            Padding="15,0">

                        <Entry x:Name="txPorcoes"
                               Text="{Binding Porcoes}"
                               Placeholder="Ex.: 4"
                               PlaceholderColor="Gray"
                               TextColor="Black"
                               FontSize="14"
                               Keyboard="Numeric"
                               MaxLength="2"
                               VerticalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>

                <!-- CheckBox: campo booleano "vegetariana" -->
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="5"
                                       VerticalOptions="End"
                                       HeightRequest="55">

                    <CheckBox x:Name="cbVegetariana"
                              IsChecked="{Binding Vegetariana}"
                              Color="Black"
                              VerticalOptions="Center"/>

                    <Label Text="Vegetariana 🌱"
                           FontSize="14"
                           TextColor="Black"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

            </Grid>


            <!-- DIFICULDADE (RadioButton: só uma opção pode ser escolhida) -->
            <Label Text="Dificuldade"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <HorizontalStackLayout Spacing="10">

                <RadioButton x:Name="rbFacil"
                             Content="Fácil"
                             Value="Fácil"
                             GroupName="Dificuldade"
                             TextColor="Black"
                             CheckedChanged="Dificuldade_CheckedChanged"/>

                <RadioButton x:Name="rbMedia"
                             Content="Média"
                             Value="Média"
                             GroupName="Dificuldade"
                             TextColor="Black"
                             CheckedChanged="Dificuldade_CheckedChanged"/>

                <RadioButton x:Name="rbDificil"
                             Content="Difícil"
                             Value="Difícil"
                             GroupName="Dificuldade"
                             TextColor="Black"
                             CheckedChanged="Dificuldade_CheckedChanged"/>
            </HorizontalStackLayout>


            <!-- INGREDIENTES -->
            <Label Text="Ingredientes"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <!-- Lista dos ingredientes já adicionados -->
            <VerticalStackLayout x:Name="slIngredientes"
                                 Spacing="10"
                                 BindableLayout.ItemsSource="{Binding Ingredientes}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:IngredienteDaReceita">

                        <Border Stroke="#EEEEEE"
                                StrokeThickness="1"
                                BackgroundColor="#F8F8F8"
                                StrokeShape="RoundRectangle 14"
                                Padding="15,10">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label Text="{Binding Descricao}"
                                       FontSize="14"
                                       TextColor="Black"
                                       VerticalOptions="Center"/>

                                <!-- Remover ingrediente -->
                                <Label Grid.Column="1"
                                       Text="✕"
                                       FontSize="18"
                                       TextColor="Gray"
                                       Padding="10,0,0,0"
                                       VerticalOptions="Center">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="RemoverIngrediente_Tapped"
                                                              CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Campos para adicionar um ingrediente -->
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,*,Auto"
                  RowSpacing="10"
                  ColumnSpacing="10">

                <Border Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Stroke="#EEEEEE"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="55"
                        StrokeShape="RoundRectangle 18"
                        Padding="15,0">

                    <Entry x:Name="txIngredienteNome"
                           Text="{Binding NovoIngredienteNome}"
                           Placeholder="Ingrediente (ex.: Farinha)"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           VerticalOptions="Center"/>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Stroke="#EEEEEE"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="55"
                        StrokeShape="RoundRectangle 18"
                        Padding="15,0">

                    <Entry x:Name="txIngredienteQuantidade"
                           Text="{Binding NovoIngredienteQuantidade}"
                           Placeholder="Qtd."
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           Keyboard="Numeric"
                           VerticalOptions="Center"/>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Stroke="#EEEEEE"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="55"
                        StrokeShape="RoundRectangle 18"
                        Padding="15,0">

                    <Picker x:Name="pkIngredienteUnidade"
                            ItemsSource="{Binding Unidades}"
                            SelectedItem="{Binding NovoIngredienteUnidade}"
                            Title="Unidade"
                            TitleColor="Gray"
                            TextColor="Black"
                            FontSize="14"
                            VerticalOptions="Center"/>
                </Border>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        x:Name="btAdicionarIngrediente"
                        Text="+"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Black"
                        WidthRequest="55"
                        HeightRequest="55"
                        CornerRadius="18"
                        Padding="0"
                        Clicked="btAdicionarIngrediente_Clicked"/>
            </Grid>

            <Label Text="{Binding ErroIngrediente}"
                   IsVisible="{Binding TemErroIngrediente}"
                   FontSize="13"
                   TextColor="#D32F2F"/>


            <!-- MODO DE PREPARO -->
            <Label Text="Modo de preparo"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="Black"/>

            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="150"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,5">

                <Editor x:Name="edModoPreparo"
                        Text="{Binding ModoPreparo}"
                        Placeholder="1. Misture os ingredientes...&#10;2. Leve ao forno..."
                        PlaceholderColor="Gray"
                        TextColor="Black"
                        FontSize="14"/>
            </Border>


            <!-- MENSAGEM DE ERRO -->
            <Label x:Name="lbErro"
                   Text="{Binding MensagemErro}"
                   IsVisible="{Binding TemErro}"
                   FontSize="13"
                   TextColor="#D32F2F"
                   HorizontalOptions="Center"/>


            <!-- BOTÃO SALVAR -->
            <Button x:Name="btSalvar"
                    Text="{Binding TextoBotao}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="Black"
                    HeightRequest="55"
                    CornerRadius="18"
                    Margin="0,10,0,0"
                    Clicked="btSalvar_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
