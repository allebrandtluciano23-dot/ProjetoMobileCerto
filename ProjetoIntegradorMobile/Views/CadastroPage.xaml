<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.CadastroPage"
             xmlns:vm="clr-namespace:ProjetoIntegradorMobile.ViewModels"
             x:DataType="vm:CadastroViewModel"
             BackgroundColor="{StaticResource Fundo}"
             Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="24,45,24,36" Spacing="22">

            <!-- VOLTAR -->
            <Border WidthRequest="44"
                    HeightRequest="44"
                    Stroke="{StaticResource Borda}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource Cartao}"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Start">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped"/>
                </Border.GestureRecognizers>

                <Path Data="{StaticResource IconeVoltar}"
                      Style="{StaticResource Icone}"
                      WidthRequest="18"
                      HeightRequest="18"/>
            </Border>

            <!-- TÍTULO -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Criar conta"
                       FontFamily="Bricolage"
                       FontSize="32"/>

                <Label Text="Junte-se ao CheefBook e comece a sua jornada na cozinha!"
                       Style="{StaticResource TextoSecundario}"
                       FontSize="15"/>
            </VerticalStackLayout>


            <!-- CAMPOS -->
            <VerticalStackLayout Spacing="14">

                <!-- NOME -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nome completo" Style="{StaticResource Rotulo}"/>

                    <Border Stroke="{StaticResource Borda}" StrokeThickness="1" BackgroundColor="{StaticResource Cartao}"
                            HeightRequest="52" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="txNome"
                               Text="{Binding Nome}"
                               Placeholder="Seu nome"
                               FontSize="15"
                               Keyboard="Text"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <!-- E-MAIL -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="E-mail" Style="{StaticResource Rotulo}"/>

                    <Border Stroke="{StaticResource Borda}" StrokeThickness="1" BackgroundColor="{StaticResource Cartao}"
                            HeightRequest="52" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="txEmail"
                               Text="{Binding Email}"
                               Placeholder="seu@email.com"
                               FontSize="15"
                               Keyboard="Email"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <!-- SENHA -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Senha" Style="{StaticResource Rotulo}"/>

                    <Border Stroke="{StaticResource Borda}" StrokeThickness="1" BackgroundColor="{StaticResource Cartao}"
                            HeightRequest="52" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="txSenha"
                                   Text="{Binding Senha}"
                                   Placeholder="Crie uma senha"
                                   FontSize="15"
                                   IsPassword="True"
                                   VerticalOptions="Center"/>

                            <!-- Mostrar / ocultar senha -->
                            <Image Grid.Column="1"
                                   x:Name="imOlho"
                                   Source="eye_off.png"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   Opacity="0.55"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="MostrarSenha_Tapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- CONFIRMAR SENHA -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Confirmar senha" Style="{StaticResource Rotulo}"/>

                    <Border Stroke="{StaticResource Borda}" StrokeThickness="1" BackgroundColor="{StaticResource Cartao}"
                            HeightRequest="52" StrokeShape="RoundRectangle 14" Padding="14,0">
                        <Entry x:Name="txConfirmarSenha"
                               Text="{Binding ConfirmarSenha}"
                               Placeholder="Repita a senha"
                               FontSize="15"
                               IsPassword="True"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>


            <!-- MENSAGEM DE ERRO -->
            <Label x:Name="lbErro"
                   Text="{Binding MensagemErro}"
                   Style="{StaticResource TextoErro}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding TemErro}"/>


            <!-- BOTÃO CADASTRAR -->
            <Border BackgroundColor="{StaticResource Destaque}"
                    StrokeThickness="0"
                    HeightRequest="54"
                    StrokeShape="RoundRectangle 16">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Cadastrar_Tapped"/>
                </Border.GestureRecognizers>

                <Label Text="Cadastrar"
                       FontFamily="InterSemiBold"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>


            <!-- JÁ TEM CONTA -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">

                <Label Text="Já tem uma conta?"
                       Style="{StaticResource TextoSecundario}"
                       FontSize="14"/>

                <Label Text="Entrar"
                       FontFamily="InterSemiBold"
                       FontSize="14"
                       TextColor="{StaticResource Destaque}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Entrar_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
