<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoIntegradorMobile.Views.CadastroPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="30,50,30,30" Spacing="18">

            <!-- VOLTAR -->
            <Label Text="←"
                   FontSize="28"
                   TextColor="Black"
                   HorizontalOptions="Start">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Voltar_Tapped"/>
                </Label.GestureRecognizers>
            </Label>


            <!-- CABEÇALHO -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,10">

                <VerticalStackLayout Spacing="6">

                    <Label Text="Criar conta"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Label Text="Junte-se ao CheefBook e comece a sua jornada na cozinha!"
                           FontSize="14"
                           TextColor="Gray"/>
                </VerticalStackLayout>

            </Grid>


            <!-- NOME COMPLETO -->
            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,0">

                <Grid ColumnDefinitions="Auto,*">

                    <Entry Grid.Column="1"
                           x:Name="nomeEntry"
                           Placeholder="Nome completo"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           Keyboard="Text"
                           VerticalOptions="Center"/>

                </Grid>
            </Border>

            <!-- E-MAIL -->
            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,0">

                <Grid ColumnDefinitions="Auto,*">
                    
                    <Entry Grid.Column="1"
                           x:Name="emailEntry"
                           Placeholder="E-mail"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           Keyboard="Email"
                           VerticalOptions="Center"/>

                </Grid>
            </Border>

            <!-- SENHA -->
            <Border Stroke="#EEEEEE"
                StrokeThickness="1"
                BackgroundColor="White"
                HeightRequest="55"
                StrokeShape="RoundRectangle 18"
                Padding="15,0">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Entry Grid.Column="1"
                    x:Name="senhaEntry"
                    Placeholder="Senha"
                    PlaceholderColor="Gray"
                    TextColor="Black"
                    FontSize="14"
                    IsPassword="True"
                    VerticalOptions="Center"/>

                    <!-- Mostrar / ocultar senha -->
                    <Image Grid.Column="2"
                    x:Name="imgOlho"
                    Source="eye_off.png"
                    WidthRequest="24"
                    HeightRequest="24"
                    VerticalOptions="Center">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MostrarSenha_Tapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
            </Border>


            <!-- CONFIRMAR SENHA -->
            <Border Stroke="#EEEEEE"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 18"
                    Padding="15,0">

                <Grid ColumnDefinitions="Auto,*">

                    <Entry Grid.Column="1"
                           x:Name="confirmarSenhaEntry"
                           Placeholder="Confirmar senha"
                           PlaceholderColor="Gray"
                           TextColor="Black"
                           FontSize="14"
                           IsPassword="True"
                           VerticalOptions="Center"/>

                </Grid>
            </Border>


            <!-- MENSAGEM DE ERRO -->
            <Label x:Name="lblErro"
                   Text=""
                   FontSize="13"
                   TextColor="#D32F2F"
                   HorizontalOptions="Center"
                   IsVisible="False"/>


            <!-- BOTÃO CADASTRAR -->
            <Border BackgroundColor="Black"
                    StrokeThickness="0"
                    HeightRequest="55"
                    Margin="0,5,0,0"
                    StrokeShape="RoundRectangle 18">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Cadastrar_Tapped"/>
                </Border.GestureRecognizers>

                <Label Text="Cadastrar"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- JÁ TEM CONTA -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">

                <Label Text="Já tem uma conta?"
                       FontSize="13"
                       TextColor="Gray"/>

                <Label Text="Entrar"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="Black"
                       TextDecorations="Underline">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Entrar_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>