    <!-- =====================================================================
         ESTILOS DO CHEEFBOOK (usados nas telas com Style="{StaticResource Nome}")
         Fontes: "Bricolage" = títulos | "Inter" = texto | "InterSemiBold" = texto em destaque
         ===================================================================== -->

    <!-- ===== Textos ===== -->
    <Style TargetType="Label" x:Key="TituloTela">
        <Setter Property="FontFamily" Value="Bricolage" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
    </Style>

    <Style TargetType="Label" x:Key="TituloSecao">
        <Setter Property="FontFamily" Value="Bricolage" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
    </Style>

    <Style TargetType="Label" x:Key="TituloCartao">
        <Setter Property="FontFamily" Value="Bricolage" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
    </Style>

    <Style TargetType="Label" x:Key="Rotulo">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
    </Style>

    <Style TargetType="Label" x:Key="TextoSecundario">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
    </Style>

    <Style TargetType="Label" x:Key="Sobrelinha">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Destaque}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.8" />
    </Style>

    <Style TargetType="Label" x:Key="TextoErro">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Perigo}" />
    </Style>

    <!-- ===== Botões ===== -->
    <Style TargetType="Button" x:Key="BotaoBase">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Ação principal da tela (Salvar, Entrar...) -->
    <Style TargetType="Button" x:Key="BotaoPrincipal" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Destaque}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- Ação forte, mas não a principal (Capturar, Editar, Nova receita) -->
    <Style TargetType="Button" x:Key="BotaoEscuro" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Tinta}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- Contorno na cor principal (Favoritar) -->
    <Style TargetType="Button" x:Key="BotaoContorno" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Cartao}" />
        <Setter Property="TextColor" Value="{StaticResource Destaque}" />
        <Setter Property="BorderColor" Value="{StaticResource Destaque}" />
        <Setter Property="BorderWidth" Value="1.5" />
    </Style>

    <!-- Ação secundária (Fechar, Cancelar, Agora não) -->
    <Style TargetType="Button" x:Key="BotaoSuave" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="{StaticResource Chip}" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
    </Style>

    <!-- Excluir / Sair da conta -->
    <Style TargetType="Button" x:Key="BotaoPerigo" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource PerigoClaro}" />
        <Setter Property="TextColor" Value="{StaticResource Perigo}" />
    </Style>

    <!-- ===== Opção de escolha única (RadioButton da dificuldade) =====
         Continua sendo um RadioButton (mesmo GroupName e evento CheckedChanged);
         o ControlTemplate só troca o desenho: um botão com a bolinha dentro.
         Marcado: borda e bolinha na cor principal. -->
    <ControlTemplate x:Key="ModeloOpcao">
        <Border StrokeThickness="1.5"
                Stroke="{StaticResource Borda}"
                BackgroundColor="{StaticResource Cartao}"
                StrokeShape="RoundRectangle 14"
                HeightRequest="46"
                Padding="8,0">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{StaticResource Destaque}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource DestaqueClaro}" />
                                <Setter TargetName="elBordaMarcada" Property="Opacity" Value="1" />
                                <Setter TargetName="elMiolo" Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{StaticResource Borda}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource Cartao}" />
                                <Setter TargetName="elBordaMarcada" Property="Opacity" Value="0" />
                                <Setter TargetName="elMiolo" Property="Opacity" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                    <Ellipse x:Name="elBorda"
                             Stroke="{StaticResource TextoFraco}"
                             StrokeThickness="1.5"
                             WidthRequest="16"
                             HeightRequest="16"/>
                    <Ellipse x:Name="elBordaMarcada"
                             Stroke="{StaticResource Destaque}"
                             StrokeThickness="1.5"
                             WidthRequest="16"
                             HeightRequest="16"
                             Opacity="0"/>
                    <Ellipse x:Name="elMiolo"
                             Fill="{StaticResource Destaque}"
                             WidthRequest="8"
                             HeightRequest="8"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Opacity="0"/>
                </Grid>
                <ContentPresenter VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </ControlTemplate>

    <Style TargetType="RadioButton" x:Key="OpcaoDificuldade">
        <Setter Property="ControlTemplate" Value="{StaticResource ModeloOpcao}" />
        <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ===== Ícones (Path com os desenhos de Icones.xaml) ===== -->
