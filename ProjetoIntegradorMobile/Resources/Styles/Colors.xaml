<?xml version="1.0" encoding="UTF-8" ?>
<!--
    CORES DO CHEEFBOOK (visual "caderno de receitas": fundo creme + terracota).
    Todas as telas usam estas chaves com {StaticResource Nome}. Para mudar uma cor no app inteiro,
    basta mudar aqui.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== Paleta do app ===== -->
    <Color x:Key="Fundo">#FAF6EF</Color>            <!-- fundo creme das telas -->
    <Color x:Key="Cartao">#FFFFFF</Color>           <!-- cartões e campos -->
    <Color x:Key="Tinta">#2B2420</Color>            <!-- texto principal e botão escuro -->
    <Color x:Key="TextoSuave">#7A6E66</Color>       <!-- texto secundário -->
    <Color x:Key="TextoFraco">#A0948A</Color>       <!-- dicas e placeholders -->
    <Color x:Key="Borda">#E8DED2</Color>            <!-- borda dos campos -->
    <Color x:Key="BordaCartao">#EFE6DA</Color>      <!-- borda dos cartões -->
    <Color x:Key="Divisor">#F2EBE1</Color>          <!-- linha entre itens de uma lista -->
    <Color x:Key="Chip">#F0E8DD</Color>             <!-- categoria não selecionada e botão suave -->
    <Color x:Key="Destaque">#B4472A</Color>         <!-- cor principal (terracota) -->
    <Color x:Key="DestaqueClaro">#FBEDE7</Color>    <!-- fundo de opção selecionada -->
    <Color x:Key="FundoAvatar">#F0E3D3</Color>      <!-- círculo da foto quando não há foto -->
    <Color x:Key="FundoIcone">#F6EEE4</Color>       <!-- quadradinho atrás dos ícones -->
    <Color x:Key="FotoVazia">#E9C9A8</Color>        <!-- espaço da foto quando a receita não tem foto -->
    <Color x:Key="Vegetariana">#4E6B2F</Color>      <!-- selo "Vegetariana" -->
    <Color x:Key="Perigo">#A3352B</Color>           <!-- texto de excluir / sair / erro -->
    <Color x:Key="PerigoClaro">#F6E1DA</Color>      <!-- fundo do botão excluir / sair -->
    <Color x:Key="FundoEscurecido">#80000000</Color><!-- fundo atrás dos avisos -->

    <!-- ===== Cores do modelo do MAUI (usadas pelos estilos padrão em Styles.xaml) ===== -->
    <Color x:Key="Primary">#B4472A</Color>
    <Color x:Key="PrimaryDark">#B4472A</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#F0E8DD</Color>
    <Color x:Key="SecondaryDarkText">#2B2420</Color>
    <Color x:Key="Tertiary">#2B2420</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#B4472A</Color>
    <Color x:Key="MidnightBlue">#2B2420</Color>
    <Color x:Key="OffBlack">#2B2420</Color>

    <Color x:Key="Gray100">#F0E8DD</Color>
    <Color x:Key="Gray200">#E8DED2</Color>
    <Color x:Key="Gray300">#C9BCB0</Color>
    <Color x:Key="Gray400">#A0948A</Color>
    <Color x:Key="Gray500">#7A6E66</Color>
    <Color x:Key="Gray600">#5A4F48</Color>
    <Color x:Key="Gray900">#2B2420</Color>
    <Color x:Key="Gray950">#1E1916</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
